<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
        <LangVersion>9</LangVersion>
        <Nullable>enable</Nullable>
        <RootNamespace>ComputerysBitStream</RootNamespace>
        <DefineConstants>$(DefineConstants);$(BitStreamDefineConstants)</DefineConstants>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <BitStreamUsesUnsafePackage Condition="$(DefineConstants.Contains('BITSTREAM_INCLUDES_SYSTEM_RUNTIME_COMPILER_SERVICES_UNSAFE'))">true</BitStreamUsesUnsafePackage>
    </PropertyGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1' and '$(BitStreamUsesUnsafePackage)' == 'true'">
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0"/>
    </ItemGroup>
    <ItemGroup>
        <Analyzer Include="Runtime\Analyzers\ComputerysBitStream.Generator.dll"/>
        <None Include="Runtime\package.json"/>
        <None Include="Runtime\ComputerysBitStream.asmdef"/>
    </ItemGroup>
</Project>
